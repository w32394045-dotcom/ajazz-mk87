      "range": "0..1000",
      "note": "官方测试模式直接给振幅，不开音频"
    }
  },
  "protocol": {
    "usb": {
      "cmd": 50,
      "cmdHex": "0x32",
      "name": "GET_LED_DATA(枚举名) / 实为逐键实时帧",
      "reportPayloadBytes": 64,
      "dataPerPacket": 56,
      "keyBytes": 4,
      "payloadLayout": "[keyValue, r, g, b] × 可见键",
      "packetHeader": {
        "0": "0xAA",
        "1": "0x32",
        "2": "本包数据字节数(56; 末包 12)",
        "3-4": "数据起始偏移 addr LE (0,56,112,...)",
        "5": "i (setMusicData 第二参数; MK87=0)",
        "6": "last 标志 (1=最后一包)",
        "7": "0",
        "8": "+ 本包数据"
      },
      "mk87Frame": {
        "keys": 87,
        "payloadBytes": 348,
        "packets": 7
      },
      "ack": {
        "cmd": 50,
        "timeoutMs": {
          "frameVersion1": 2000,
          "default": 50
        },
        "retries": 3
      },
      "rate": {
        "fps": 20,
        "packetsPerSecond": 140,
        "approxBytesPerSecond": 9100
      }
    },
    "wireless24G": {
      "condition": "connectType==='2.4G' && reportCount===64 && lightingVersion===1",
      "cmd": 60,
      "cmdHex": "0x3C",
      "payload": "RGB565 流 (2B/像素, 无键号)",
      "dataPerPacket": 56,
      "timeoutMs": 10,
      "maxRetries": 0
    },
    "generic": {
      "cmd": 53,
      "cmdHex": "0x35",
      "payload": "RGB565 流",
      "customHeader": "AA 35 seq i",
      "dataPerPacket": 60,
      "timeoutMs": 10,
      "maxRetries": 0
    },
    "webhidNote": "WebHID sendReport(0, data64) 的 data 不含 report ID 字节；原生 HID 写入时缓冲区首字节为 report ID=0，随后接上面的 64 字节报文。"
  },

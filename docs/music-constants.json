  },
  "pluginContract": {
    "base": "http://127.0.0.1:9191",
    "timeoutMs": 500,
    "endpoints": {
      "audioAmplitude": {
        "path": "/api/audio/amplitude",
        "response": "{amplitude:number 0..1000}"
      },
      "musicEffectColors": {
        "path": "/api/keyboard/musiceffect/",
        "response": "{keys:[{keyIndex,keyCode,row,col,color:'#rrggbb'}]}"
      },
      "musicEffectStart": {
        "path": "/api/keyboard/musiceffect?param=<mode>&100&<backmode>&100&<flag>"
      },
      "musicEffectClose": {
        "path": "/api/keyboard/musiceffect/close/"
      },
      "keyboardLayout": {
        "path": "/api/keyboard/layout/base64?data=<base64(json)>",
        "json": "{name,vendorId,productId,deviceMode,layouts:{rows,cols,keys}}"
      },
      "hardwareInfo": {
        "path": "/api/hardware/info",
        "response": "{cpuUsage,cpuTemp,gpuUsage,gpuTemp}"
      }
    }
  },
  "openQuestions": [
    "激活条件：是否只需持续发送 cmd 0x32 帧（假设 H1），还是需要先 SET_LED_EFFECT 切到某个模式（H2）",

      "1": "大端：先写高字节 (hi, lo)"
    },
    "alpha_variant_bytes_per_2px": 5,
    "alpha_byte": "(a0 >> 4) << 4 | (a1 >> 4)",
    "frame_bytes": 64800,
    "delay_table_len": 256,
    "delay_table": {
      "0": "frame count n",
      "1..n-1": "min(delay*5, 255)  (delay 单位=厘秒/10ms)",
      "n": "0 (终止符；最后一帧的延时槽不写)",
      "rest": 255
